{
  "name": "kiccle",
  "version": "0.1.0",
  "private": true,
  "description": "KICCLE — FOOTWEAR ARCHIVE. A cinematic sneaker exhibition (static site, no runtime dependencies).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "assets": "NODE_PATH=\"${NODE_PATH:-$(npm root -g)}\" node scripts/assets.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "NODE_PATH=\"${NODE_PATH:-$(npm root -g)}\" node scripts/verify-browser.mjs",
    "shoes": "node scripts/shoes.mjs"
  }
}
